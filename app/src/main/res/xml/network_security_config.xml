<?xml version="1.0" encoding="utf-8"?>
<!--
    Allows cleartext HTTP only to the local development server so the in-app
    Live Preview WebView can load the running app. All other traffic remains
    subject to the platform default (cleartext blocked).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>